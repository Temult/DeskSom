{
  "name": "desksom",
  "version": "0.2.0-rc.15",
  "private": true,
  "type": "module",
  "dependencies": {
    "@wonderwhy-er/desktop-commander": "0.3.0"
  },
  "description": "Private Windows-to-ChatGPT MCP bridge built on open-source Desktop Commander",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test:acceptance": "node acceptance.mjs",
    "test": "node scripts/Run-Tests.mjs",
    "test:installer": "node --test scripts/tests/installer.test.mjs",
    "test:discovery": "node --test --test-concurrency=1 catalog.test.mjs discovery.integration.test.mjs",
    "test:roots": "node --test scripts/tests/roots.test.mjs",
    "test:gui": "node --test scripts/tests/gui.test.mjs",
    "test:wizard": "node --test scripts/tests/wizard.test.mjs",
    "test:core": "node scripts/Run-Tests.mjs --mode core",
    "test:index": "node scripts/Run-Tests.mjs --mode index",
    "test:all": "node scripts/Run-Tests.mjs --mode all"
  },
  "license": "MIT",
  "overrides": {
    "markdown-it": "14.3.3",
    "md-to-pdf": {
      "chokidar": "4.0.3"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "proxy-addr": "2.0.8",
    "argparse": "2.0.1"
  }
}
